{
  "name": "fju-im-project",
  "version": "0.1.0",
  "private": true,
  "description": "輔仁大學資訊管理學系專題管理平台。prototype/ 是可點的前端原型（評選用）；正式程式碼之後從零開始長。",
  "scripts": {
    "dev": "pnpm -C prototype dev",
    "proto": "pnpm -C prototype exec next dev --port 3100",
    "lint": "pnpm -C prototype lint",
    "build": "pnpm -C prototype build"
  },
  "packageManager": "pnpm@11.0.9"
}

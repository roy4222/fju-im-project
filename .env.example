# 本機 .env 範本（契約 05 §6：憑證分三組，分檔存放，互不可見）。
#
# 這個檔案只有變數名稱，**不放任何值**。複製成三個檔案再由維運填：
#   .env          app 組——app 與 worker 讀
#   .env.migrate  owner 組——只有 migrate 與 reset 讀
#   .env.backup   backup 組——只有 backup 服務讀
#
# **VM 上不用這三個檔**（2026-09-24 兩站版）：值放在 Doppler 專案 fju-im-capstone
# （stg＝測試站、prd＝正式站），由 ops/lib/site.sh 用每站一把唯讀 service token 放進程序環境，
# docker-compose.vm.yml 再逐項交給各服務。VM 上的鍵另外還有 APP_DB_PASSWORD
# （ops/deploy.sh 用它設定 fju_app 的密碼），完整清單見 ops/README.md。
# R2、age、告警 webhook 都不用（Roy 2026-09-23 定案）。Turnstile 在 B 階段（2026-10）改成要用，見 app 組。
# 鍵名和 docs/engineering/operations/02 環境變數、OAuth 與 Secrets 清單.md 的「鍵總表」一一對應；
# 改這個檔就要一起改那張表（比對指令寫在該文件）。

# ─────────────────────────────────────────
# app 組 → .env
# ─────────────────────────────────────────
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FILES_ROOT=
FILE_MAX_BYTES=
BUSINESS_CLOCK_OVERRIDE_ENABLED=
# 寄信（Brevo）：MAIL_FROM 例如「專題管理平台 <noreply@roy422.dev>」；另可加 MAIL_REPLY_TO（選配）。
# 少了金鑰站照樣起得來，只是寄信回失敗（不會改存內文）。
BREVO_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=
# 擷取模式：設 1 就不寄出，整封信存進 mail_outbox（e2e 從那裡讀驗證碼）。
# **只限本機與 CI**，而且 BETTER_AUTH_URL 要是 localhost／127.0.0.1 才生效；VM、Doppler 一律不設。
MAIL_CAPTURE=
# Cloudflare Turnstile（註冊、忘記密碼、重寄驗證碼的人機驗證）。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# GA4 評估 ID：只在正式站設；測試站與本機留空就不載入。
GA4_MEASUREMENT_ID=
# 連線池上限（沒設＝10；VM 的 worker 在 docker-compose.vm.yml 固定 2）。
DB_POOL_MAX=
# Healthchecks.io 的 worker 打卡網址（⑤-06）：只給 worker、app 不讀；留空＝不打卡。
HEALTHCHECKS_WORKER_URL=
# 登入身分快取秒數（沒設＝60；e2e 設 0）。
IDENTITY_CACHE_TTL_SECONDS=
# 測試用：上傳限速額度（沒設＝20；e2e 設 1000）；VM 不設。
UPLOAD_RATE_MAX=
# 開放註冊開關（沒設＝false，只有 VM 的 docker-compose.vm.yml 用；本機與 e2e 不讀）。
REGISTRATION_OPEN=

# ─────────────────────────────────────────
# owner 組 → .env.migrate
# ─────────────────────────────────────────
DATABASE_URL_OWNER=
# 只有 VM 的 ops/deploy.sh 用：每次 migrate 後把 fju_app 的密碼設成這個值（migration 只建角色不設密碼）。
APP_DB_PASSWORD=

# ─────────────────────────────────────────
# backup 組 → .env.backup
# ─────────────────────────────────────────
# 目前沒有任何程式讀這個鍵（備份走 ops/backup-daily.sh）；留著是因為 docker-compose.yml 的 env_file
# 與 CI 都要有 .env.backup 這個檔。
DATABASE_URL_BACKUP=

# ─────────────────────────────────────────
# Compose 本身（非憑證，可留空用預設值）
# ─────────────────────────────────────────
APP_IMAGE=
GIT_COMMIT=
APP_VERSION=
IMAGE_DIGEST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
HTTP_PORT=

# 本機 .env 範本（契約 05 §6：憑證分三組，分檔存放，互不可見）。
#
# 這個檔案只有變數名稱，**不放任何值**。複製成三個檔案再由維運填：
#   .env          app 組——app 與 worker 讀
#   .env.migrate  owner 組——只有 migrate 與 reset 讀
#   .env.backup   backup 組——只有 backup 服務讀
#
# **VM 上不用這三個檔**（2026-09-24 兩站版）：值放在 Doppler 專案 fju-im-capstone
# （stg＝測試站、prd＝正式站），由 ops/lib/site.sh 用每站一把唯讀 service token 放進程序環境，
# docker-compose.vm.yml 再逐項交給各服務。VM 上的鍵另外還有 APP_DB_PASSWORD
# （ops/deploy.sh 用它設定 fju_app 的密碼），完整清單見 ops/README.md。
# Turnstile、R2、age、告警 webhook 都不用（Roy 2026-09-23 定案）。

# ─────────────────────────────────────────
# app 組 → .env
# ─────────────────────────────────────────
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FILES_ROOT=
FILE_MAX_BYTES=
BUSINESS_CLOCK_OVERRIDE_ENABLED=

# ─────────────────────────────────────────
# owner 組 → .env.migrate
# ─────────────────────────────────────────
DATABASE_URL_OWNER=

# ─────────────────────────────────────────
# backup 組 → .env.backup
# ─────────────────────────────────────────
DATABASE_URL_BACKUP=

# ─────────────────────────────────────────
# Compose 本身（非憑證，可留空用預設值）
# ─────────────────────────────────────────
APP_IMAGE=
GIT_COMMIT=
APP_VERSION=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
HTTP_PORT=

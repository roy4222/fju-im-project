{
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": false,
    "jsx": "react-jsx",
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "./generated/types",
    "rootDir": "../src",
    "baseUrl": "..",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "../src/components/ui/**/*.tsx",
    "../src/lib/utils.ts"
  ]
}
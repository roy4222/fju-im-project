# ~/.ssh/config 範本（前置清單 §2.4；票 #187）。
#
# 貼到自己機器的 ~/.ssh/config 後，就可以用 `ssh fju-vm` 連線。
# 這裡**不含任何金鑰**；IdentityFile 指到你自己的私鑰路徑。

Host fju-vm
  HostName 140.136.155.167
  User roy422roy
  # 換成自己的私鑰；預設 ~/.ssh/id_ed25519
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  ServerAliveInterval 30
  ServerAliveCountMax 4

# 自動部署用的帳號（SOP 03 才會用到；公鑰要先貼到 VM 的
# /home/deploy/.ssh/authorized_keys，私鑰同時放進 GitHub Secrets）。
Host fju-vm-deploy
  HostName 140.136.155.167
  User deploy
  IdentityFile ~/.ssh/fju_deploy_ed25519
  IdentitiesOnly yes

# 重置測試站專用金鑰（網站驗收全套；ops/README.md「重置測試站專用金鑰：安裝與使用」）。
# 只能跑 status／pause-deploy／resume-deploy／reset／seed-demo／snapshot <名稱>／restore <名稱>，
# 例：ssh fju-reset status。不能開 shell、不能轉送 port、不碰正式站。
# 每個子命令＝一次新連線；VM 的 ufw 對 22 埠限速 30 秒 6 次，連發時中間停幾秒。
Host fju-reset
  HostName 140.136.155.167
  User fjureset
  IdentityFile ~/.ssh/fju_reset
  IdentitiesOnly yes
  BatchMode yes
  ConnectTimeout 20
  # reset／restore 要跑幾分鐘，中途沒有輸出時也別讓連線被當成斷了。
  ServerAliveInterval 30
  ServerAliveCountMax 10
  ForwardAgent no
  ClearAllForwardings yes
  RequestTTY no

# 驗收結果送上開發者後台（ops/status-publish-run.sh；acceptance-night.sh 收尾自動叫）。
# 在 Mac mini 或 MacBook 用；金鑰由 ops/status-prepare.sh 產生，公鑰在 VM 上只能 rrsync 寫
# /srv/fju/status/inbox（不能開 shell、不能讀）。一夜只連一次。
# HostName 是占位符：貼到自己的 ~/.ssh/config 後把 VM_IP_HERE 換成 VM 的 IP（repo 不寫真實位址）。
Host fju-status-publish
  HostName VM_IP_HERE
  User fjustatus
  IdentityFile ~/.ssh/fju_status_publish
  IdentitiesOnly yes
  BatchMode yes
  ConnectTimeout 20
  ServerAliveInterval 15
  ServerAliveCountMax 4
  ForwardAgent no
  ClearAllForwardings yes
  RequestTTY no

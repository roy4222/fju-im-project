[Unit]
Description=開發者後台：拉新映像、起服務、補建 PgHero 監控角色（ops/status-up.sh）
After=docker.service network-online.target
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/fju/app
# 不經主網站的秘密流程：status-up.sh 只讀 /srv/fju/status/secrets，psql 的帳號在 postgres 容器裡展開。
ExecStart=/srv/fju/app/ops/status-up.sh
TimeoutStartSec=15min
SyslogIdentifier=fju-status-update

# VM 用的 Caddy 設定（兩站版，2026-09-24）。由 docker-compose.edge.yml（project fju-edge）掛進去。
#
# 與 repo 根目錄那份 Caddyfile 的差別：
#   - 根目錄那份是**本機**用的：`:80`、`auto_https off`，不申請憑證。
#   - 這一份綁兩個真實 host，由 Caddy 自己向 Let's Encrypt 取得憑證。
#     DNS 兩筆 A 記錄（Cloudflare 只當 DNS，不走 proxy）與校方對內 80／443 必須先就緒，
#     否則 HTTP-01 驗證會失敗。
#
# 某一站還沒部署時，那個 host 回 502，另一站不受影響。
# 改完這份要 `docker compose -f docker-compose.edge.yml restart caddy`（admin 關掉了，不能 reload）。

{
	admin off
	# 憑證通知信箱（Let's Encrypt 用來寄到期提醒）。
	email {$ACME_EMAIL:roy422roy@gmail.com}
	# 只走 HTTP/1.1 與 HTTP/2：compose 與 ufw 都只開 TCP，不廣告 HTTP/3，
	# 瀏覽器就不會先去撞一個不通的 UDP 443。
	servers {
		protocols h1 h2
	}
}

(common) {
	# 上傳上限（契約 02 §6、契約 03 §5）：單檔 100MiB 加上 multipart 餘裕。
	# 擋在 proxy 這一層，不會進到 app；Server Action 的 bodySizeLimit 維持預設 1MB。
	request_body {
		max_size {$UPLOAD_MAX_SIZE:105MB}
	}

	encode zstd gzip

	# 健康檢查不留存取紀錄。
	@health path /api/health
	log_skip @health

	log {
		output stdout
		format console
	}
}

# 正式站（Compose project fju-prod）。
fju.roy422.dev {
	import common
	reverse_proxy fju-prod-app:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}
}

# 測試站（Compose project fju-test）。不讓搜尋引擎收錄。
test.fju.roy422.dev {
	import common
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy fju-test-app:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}
}

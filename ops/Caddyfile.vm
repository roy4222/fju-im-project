# VM 用的 Caddy 設定（兩站版，2026-09-24）。由 docker-compose.edge.yml（project fju-edge）掛進去。
#
# 與 repo 根目錄那份 Caddyfile 的差別：
#   - 根目錄那份是**本機**用的：`:80`、`auto_https off`，不申請憑證。
#   - 這一份綁兩個真實 host，由 Caddy 自己向 Let's Encrypt 取得憑證。
#     DNS 兩筆 A 記錄與校方對內 80／443 必須先就緒，否則 HTTP-01 驗證會失敗。
#     兩種模式都能用，不必配合切換時間：Cloudflare 灰雲（只當 DNS）時連線來自訪客本人，
#     橘雲（代理）時連線來自 Cloudflare、真實 IP 在 CF-Connecting-IP（見下面 trusted_proxies）。
#
# 某一站還沒部署時，那個 host 回 502，另一站不受影響。
# 改完這份要 `docker compose -f docker-compose.edge.yml restart caddy`（admin 關掉了，不能 reload）。

{
	admin off
	# 憑證通知信箱（Let's Encrypt 用來寄到期提醒）。
	email {$ACME_EMAIL:roy422roy@gmail.com}
	# 只走 HTTP/1.1 與 HTTP/2：compose 與 ufw 都只開 TCP，不廣告 HTTP/3，
	# 瀏覽器就不會先去撞一個不通的 UDP 443。
	servers {
		protocols h1 h2
		# 只有從 Cloudflare 來的連線，才相信它帶的 CF-Connecting-IP；其他來源帶這個標頭一律忽略，
		# {client_ip} 就是連線 IP（所以灰雲、橘雲、直連都正確，偽造標頭無效）。
		# 範圍抓取日期 2026-10-19，來源 https://www.cloudflare.com/ips-v4 與 /ips-v6；
		# 與 ops/cloudflare-origin-lock.sh 是同一份，更新時兩個檔一起改。
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(common) {
	# 上傳上限（契約 02 §6、契約 03 §5）：單檔 100MiB 加上 multipart 餘裕。
	# 擋在 proxy 這一層，不會進到 app；Server Action 的 bodySizeLimit 維持預設 1MB。
	request_body {
		max_size {$UPLOAD_MAX_SIZE:105MB}
	}

	encode zstd gzip

	# 健康檢查不留存取紀錄。
	@health path /api/health
	log_skip @health

	log {
		output stdout
		format console
	}
}

# 正式站（Compose project fju-prod）。
fju.roy422.dev {
	import common
	reverse_proxy fju-prod-app:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {client_ip}
	}
}

# 測試站（Compose project fju-test）。不讓搜尋引擎收錄。
test.fju.roy422.dev {
	import common
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy fju-test-app:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {client_ip}
	}
}
